      selectExp(expNum) {
        if (![1,2,3].includes(expNum)) return;
        this.currentExp = expNum;
        document.getElementById('areaCanvasSubtitle').textContent = expNum === 3 ? 'Compara la esfera con cuatro discos del mismo radio' : 'Observa cómo la superficie 3D se despliega en el plano';
        this.group.rotation.set(0,0,0);
        this.expStep = 1;
        this.unfoldT = 0;
        this.targetUnfoldT = 0;
        document.getElementById('sliderAreaUnfold').value = 0;

        [1, 2, 3].forEach(n => {
          const btn = document.getElementById(`btnAreaExp_${n}`);
          if (btn) {
            btn.className = n === expNum
              ? 'lab-btn px-3.5 py-1.5 rounded-xl font-futuristic font-bold text-xs bg-purple-500 text-white shadow-lg'
              : 'lab-btn px-3.5 py-1.5 rounded-xl font-futuristic font-bold text-xs bg-slate-800 text-slate-300 border border-white/15';
          }
        });

        this.renderGuidedPanel();
        const remembered=this.unfoldT;
        this.measuringBounds=true; this.unfoldT=1; this.rebuild3D(); fitThreeView(this,this.group,1.22);
        this.unfoldT=remembered;this.measuringBounds=false;this.expStep=1;
        this.rebuild3D();this.renderGuidedPanel();this.refreshUnfoldLabel();
      },

      animateUnfold() {
        this.targetUnfoldT = this.targetUnfoldT < 0.5 ? 1 : 0;
        SoundSystem.playHighlight();
        this.refreshUnfoldLabel();
      },

      onUnfoldSlider(val) {
        this.unfoldT = THREE.MathUtils.clamp(Number(val) || 0,0,1);
        this.targetUnfoldT = this.unfoldT;
        this.refreshUnfoldLabel();
        this.rebuild3D();
      },

      rebuild3D() {
        if (!this.group) return;
        clearThreeGroup(this.group);
        const t = this.unfoldT, overlay = document.getElementById('areaOverlayLabels');
        const add=(geo,color,key,opacity=0.85)=>addThreeSurface(this.group,geo,color,key,opacity);
        if(this.currentExp===1){
          const r=1.2,h=2.8;
          overlay.innerHTML='<div class="font-futuristic font-bold text-cyan-300">CILINDRO: PARED Y 2 TAPAS</div><div>Pared abierta: <b>rectángulo</b></div><div>Largo = <b>2 × π × r</b> · Alto = <b>h</b></div>';
          add(cylinderUnfoldGeometry(r,h,t),0x06b6d4,'lateral');
          [-1,1].forEach(sign=>{const b=add(new THREE.CircleGeometry(r,48),0xfbbf24,'bases');b.rotation.x=-sign*Math.PI/2*(1-t);b.position.set(0,sign*(h/2+r*t),0);});
        }else if(this.currentExp===2){
          const r=1.3,h=2.6,g=Math.hypot(r,h);
          overlay.innerHTML='<div class="font-futuristic font-bold text-purple-300">CONO: PARED Y 1 BASE</div><div>Pared abierta: <b>forma de abanico</b></div><div>Generatriz <b>g</b>: medida inclinada</div>';
          add(coneUnfoldGeometry(r,h,t),0xa855f7,'lateral');
          const b=add(new THREE.CircleGeometry(r,48),0x22d3ee,'base');b.rotation.x=-Math.PI/2*(1-t);b.position.set(0,-h/2-t*((g-h)/2+r),0);
        }else{
          const r=1.2;
          overlay.innerHTML='<div class="font-futuristic font-bold text-amber-300">ESFERA Y 4 CÍRCULOS</div><div>Comparamos la superficie que cubren</div><div><b>A = 4 × π × r × r</b></div><div>Todos los círculos tienen radio <b>r</b></div>';
          const sph=add(new THREE.SphereGeometry(r,40,24),0xf59e0b,'surface',0.65);sph.position.x=-2*t;
          const cyl=add(new THREE.CylinderGeometry(r,r,2*r,40,8,true),0x38bdf8,'surface',0.2);cyl.position.x=-2*t;cyl.material.wireframe=true;
          if(t>0){[-1,1].forEach(row=>[-1,1].forEach(col=>{const disk=add(new THREE.CircleGeometry(r,48),0x22d3ee,'surface',t*0.8);disk.position.set(t*(2.7+col*1.3),row*1.3*t,0);}));}
        }
        if(!this.measuringBounds&&this.unfoldT>0.95&&this.expStep===1){this.expStep=2;this.renderGuidedPanel();this.refreshUnfoldLabel();}
        if(!this.measuringBounds&&this.currentExp===3&&this.unfoldT>0.95&&typeof App!=='undefined'&&!App.state.discoveredFormulas.sphA){App.state.discoveredFormulas.sphA=true;StorageService.save(App.state);}
      },

      renderGuidedPanel() {
        const container = document.getElementById('areaGuidedContent');
        const revealEl = document.getElementById('areaFormulaRevealText');
        const note = '<p class="text-xs text-amber-200 font-bold">Para practicar usamos π ≈ 3. Los ejemplos numéricos son aproximados. Área se expresa en cm².</p>';
        const card=(title,body)=>'<div class="p-3.5 rounded-2xl bg-cyan-500/15 border border-cyan-400/40 space-y-2"><h4 class="font-futuristic font-bold text-sm text-cyan-300">'+title+'</h4>'+body+note+'</div>';
        if (this.currentExp === 1) {
          if (this.expStep === 1) {
            container.innerHTML=card('1. Abre la pared del cilindro','<p class="text-sm">Pulsa <b>DESPLEGAR CILINDRO</b>. Mira las dos tapas y la pared curva. ¿Qué forma tendrá la pared al abrirla?</p>');
            revealEl.innerHTML='Primero abre el cilindro para observar su pared.';
          } else if (this.expStep === 2) {
            container.innerHTML=card('2. La pared forma un rectángulo','<p class="text-sm">El área de un rectángulo es <b>largo × alto</b>. Aquí el largo es <b>2 × π × r</b> y el alto es <b>h</b>. Elige la operación:</p><div class="grid gap-2"><button onclick="AreaDiscoveryLab.answerExpStep(1,true)" class="lab-btn p-3 rounded-xl bg-slate-800 text-left text-sm font-bold border border-cyan-400/40">A. Multiplicar: 2 × π × r × h</button><button onclick="AreaDiscoveryLab.answerExpStep(1,false)" class="lab-btn p-3 rounded-xl bg-slate-800 text-left text-sm font-bold border border-white/15">B. Sumar: r + h</button></div>');
            revealEl.innerHTML='Área lateral = área de la pared.';
          } else {
            container.innerHTML=card('3. Suma la pared y las dos tapas','<p class="text-sm"><b>Área total = área lateral + 2 bases</b>. Cada base es un círculo: <b>π × r × r</b>.</p><div class="p-3 rounded-xl bg-slate-950 text-sm space-y-1"><b>Ejemplo: r = 1 cm y h = 2 cm</b><p>Pared: 2 × 3 × 1 × 2 = <b>12 cm²</b> (aprox.)</p><p>Una base: 3 × 1 × 1 = <b>3 cm²</b> (aprox.)</p><p>Total: 12 + 3 + 3 = <b>18 cm²</b> (aprox.)</p></div>');
            revealEl.innerHTML='<div class="text-cyan-300 font-black">Área lateral = 2 × π × r × h</div><div class="text-emerald-300 font-bold">Área total = área lateral + 2 × área de la base</div>';
          }
        } else if (this.currentExp === 2) {
          if (this.expStep === 1) {
            container.innerHTML=card('1. Abre la pared del cono','<p class="text-sm">Pulsa <b>DESPLEGAR CONO</b>. Su pared se abre como un <b>abanico</b>. La medida inclinada del cono se llama <b>generatriz (g)</b>.</p>');
            revealEl.innerHTML='Abre el cono y observa su pared y su única base.';
          } else if (this.expStep === 2) {
            container.innerHTML=card('2. Usa el radio y la generatriz','<p class="text-sm">Para el área lateral del cono multiplicamos <b>π × radio × generatriz</b>. Elige la fórmula que utiliza la medida inclinada <b>g</b>:</p><div class="grid gap-2"><button onclick="AreaDiscoveryLab.answerExpStep(2,true)" class="lab-btn p-3 rounded-xl bg-slate-800 text-left text-sm font-bold border border-cyan-400/40">A. Área lateral = π × r × g</button><button onclick="AreaDiscoveryLab.answerExpStep(2,false)" class="lab-btn p-3 rounded-xl bg-slate-800 text-left text-sm font-bold border border-white/15">B. Área lateral = π × r × h</button></div>');
            revealEl.innerHTML='Busca g en el dibujo: es la medida inclinada.';
          } else {
            container.innerHTML=card('3. Añade una sola base','<p class="text-sm"><b>Área total = área lateral + área de la base</b>. El cono tiene una sola tapa circular.</p><div class="p-3 rounded-xl bg-slate-950 text-sm space-y-1"><b>Ejemplo: r = 1 cm y g = 2 cm</b><p>Pared: 3 × 1 × 2 = <b>6 cm²</b> (aprox.)</p><p>Base: 3 × 1 × 1 = <b>3 cm²</b> (aprox.)</p><p>Total: 6 + 3 = <b>9 cm²</b> (aprox.)</p></div>');
            revealEl.innerHTML='<div class="text-purple-300 font-black">Área lateral = π × r × g</div><div class="text-emerald-300 font-bold">Área total = área lateral + área de la base</div>';
          }
        } else {
          if (this.expStep === 1) {
            container.innerHTML=card('1. Compara la esfera con cuatro círculos','<p class="text-sm">Pulsa <b>COMPARAR CON 4 CÍRCULOS</b>. Los cuatro círculos tienen el mismo radio que la esfera. Juntos cubren tanta superficie como la esfera.</p>');
            revealEl.innerHTML='Pulsa el botón de comparación para descubrir el área.';
          } else {
            container.innerHTML=card('2. Multiplica el área de un círculo por cuatro','<p class="text-sm">El área de un círculo es <b>π × r × r</b>. Para la esfera usamos <b>4 × π × r × r</b>. La comparación de áreas no cambia la forma de la esfera.</p><div class="p-3 rounded-xl bg-slate-950 text-sm space-y-1"><b>Ejemplo: radio = 2 cm</b><p>Un círculo: 3 × 2 × 2 = <b>12 cm²</b> (aprox.)</p><p>Esfera: 4 × 12 = <b>48 cm²</b> (aprox.)</p></div>');
            revealEl.innerHTML='<span class="text-amber-300 font-black">Área de la esfera = 4 × π × r × r</span>';
          }
        }
        this.refreshUnfoldLabel();
      },

      answerExpStep(exp, isRight) {
        if (exp !== this.currentExp || this.expStep !== 2) return;
        if (isRight) {
          SoundSystem.playFanfare();
          this.expStep = 3;
          App.state.discoveredFormulas[exp === 1 ? 'cylAL' : 'coneAL'] = true;
          App.state.discoveredFormulas[exp === 1 ? 'cylAT' : 'coneAT'] = true;
          StorageService.save(App.state);
          this.renderGuidedPanel();
        } else {
          SoundSystem.playError();
          let note=document.getElementById('areaAnswerFeedback');
          if(!note){note=document.createElement('p');note.id='areaAnswerFeedback';note.className='text-sm font-bold text-amber-300';note.setAttribute('role','status');document.getElementById('areaGuidedContent').appendChild(note);}
          note.textContent=exp===1?'Prueba otra vez: el área de un rectángulo se obtiene multiplicando largo por altura.':'Prueba otra vez: el área lateral del cono se calcula con π × radio × generatriz. Usa la medida inclinada g.';
        }
      },

      update(dt = 1/60) {
        this.frameDelta = Math.max(0,Math.min(0.1,Number(dt)||1/60));
        if (!this.renderer || document.getElementById('screenArea').classList.contains('hidden')) return;
        if (Math.abs(this.unfoldT - this.targetUnfoldT) > 0.005) {
          this.unfoldT += (this.targetUnfoldT - this.unfoldT) * (1-Math.exp(-6*this.frameDelta));
          if(Math.abs(this.unfoldT-this.targetUnfoldT)<0.006)this.unfoldT=this.targetUnfoldT;
          document.getElementById('sliderAreaUnfold').value = this.unfoldT;
          this.rebuild3D();
        }
        this.renderer.render(this.scene, this.camera);
      },

      resize() { resizeThreeView(this,'areaCanvasContainer',this.group); }
    };

    /********************************************************************
     * 7. ESTACIÓN 3: LABORATORIO DE VOLUMEN CON LÍQUIDOS ANIMADOS EN 3D
     *    1. Cilindro (llenado + duplicar r y h)
     *    2. Cono vs Cilindro (3 vaciados 1/3, 2/3, 3/3)
     *    3. Esfera vs Cilindro con 2 conos retirados (Principio de Cavalieri)
     ********************************************************************/

    AreaDiscoveryLab.refreshUnfoldLabel = function() {
      const label=document.getElementById('txtBtnUnfold');
      label.textContent=this.currentExp===3?(this.targetUnfoldT>0.5?'OCULTAR COMPARACIÓN':'COMPARAR CON 4 CÍRCULOS'):(this.targetUnfoldT>0.5?'REPLEGAR ':'DESPLEGAR ')+(this.currentExp===1?'CILINDRO':'CONO');
    };

    const VolumeLab = {
      scene: null, camera: null, renderer: null, group: null,
      currentExp: 1, r: 3, h: 6, fillLevel: 0.75, conePours: 0,
      cavalieriZ: 0.5, displayFill: 0, liquid: null, liquidHeight: 0,

      init() {
        if (this.renderer) { this.resize(); return; }
        const container = document.getElementById('volumeCanvasContainer');
        if (!container) return;
        this.scene = new THREE.Scene();
        this.camera = new THREE.PerspectiveCamera(45, 1, 0.1, 100);
        this.renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        this.renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        this.renderer.domElement.style.display = 'block';
        container.appendChild(this.renderer.domElement);
        this.scene.add(new THREE.AmbientLight(0xffffff, 0.85));
        const light = new THREE.DirectionalLight(0xffffff, 1);
        light.position.set(6, 10, 8);
        this.scene.add(light);
        this.group = new THREE.Group();
        this.scene.add(this.group);
        attachOrbitAndRaycast(this.renderer.domElement, this.camera, this.group, null);
        if (typeof ResizeObserver !== 'undefined') {
          this.resizeObserver = new ResizeObserver(() => this.resize());
          this.resizeObserver.observe(container);
        }
        this.resize();
        this.selectExp(this.currentExp);
      },

      resize() {
        if (!this.renderer) return;
        const container = document.getElementById('volumeCanvasContainer');
        const w = container.clientWidth, h = container.clientHeight;
        if (!w || !h) return;
        this.renderer.setSize(w, h);
        this.camera.aspect = w / h;
        const distance = Math.max(10, 4.2 / (Math.tan(Math.PI / 8) * this.camera.aspect));
        this.camera.position.set(0, distance * 0.16, distance);
        this.camera.lookAt(0, 0, 0);
        this.camera.updateProjectionMatrix();
      },

      selectExp(expNum) {
        if (![1, 2, 3].includes(Number(expNum))) return;
        this.currentExp = Number(expNum);
        this.conePours = 0;
        this.displayFill = this.currentExp === 1 ? this.fillLevel : 0;
        [1, 2, 3].forEach(n => {
          const btn = document.getElementById(`btnVolExp_${n}`);
          if (btn) {
            btn.className = n === this.currentExp
              ? 'lab-btn px-3.5 py-1.5 rounded-xl font-futuristic font-bold text-xs bg-teal-400 text-slate-950 shadow-lg'
              : 'lab-btn px-3.5 py-1.5 rounded-xl font-futuristic font-bold text-xs bg-slate-800 text-slate-300 border border-white/15';
            btn.setAttribute('aria-pressed', String(n === this.currentExp));
          }
        });
        if (this.group) this.group.rotation.set(0, 0, 0);
        this.renderControlsAndGuide();
        this.rebuild3D();
        this.resize();
      },

      onControlChange(key, value) {
        const ranges = { r: [1, 3], h: [2, 6], fillLevel: [0, 1], cavalieriZ: [-1, 1] };
        if (!ranges[key] || !Number.isFinite(Number(value))) return;
        this[key] = Math.min(ranges[key][1], Math.max(ranges[key][0], Number(value)));
        if (this.currentExp === 1 && ['r', 'h', 'fillLevel'].includes(key)) this.discover('cylV');
        if (this.currentExp === 3 && key === 'cavalieriZ') this.discover('sphV');
        this.updateControlLabels();
        this.rebuild3D();
      },

      setDimensions(r, h) {
        this.r = r; this.h = h;
        this.fillLevel = 1;
        this.displayFill = 1;
        this.discover('cylV');
        this.updateControlLabels();
        this.rebuild3D();
        SoundSystem.playLiquid();
      },

      discover(key) {
        if (typeof App === 'undefined' || !App.state || !App.state.discoveredFormulas) return;
        if (App.state.discoveredFormulas[key] === true) return;
        App.state.discoveredFormulas[key] = true;
        StorageService.save(App.state);
      },
      updateControlLabels() {
        const values = { r: this.r, h: this.h, fillLevel: this.fillLevel, cavalieriZ: this.cavalieriZ };
        Object.entries(values).forEach(([key, value]) => {
          const input = document.getElementById(`volumeSlider_${key}`);
          if (input && document.activeElement !== input) input.value = value;
          const label = document.getElementById(`volumeValue_${key}`);
          if (label) label.textContent = key === 'fillLevel' ? `${Math.round(value * 100)}%`
            : key === 'cavalieriZ' ? (Math.abs(value)<0.02 ? 'En el centro' : value<0 ? 'Debajo del centro' : 'Encima del centro')
            : `${Number(value).toFixed(1)} cm`;
        });
      },

      pourConeIntoCylinder() {
        if (this.currentExp !== 2) return;
        if (this.conePours < 3) {
          this.conePours++;
          SoundSystem.playLiquid();
          if (this.conePours === 3) { this.discover('coneV'); SoundSystem.playFanfare(); }
        } else {
          this.conePours = 0;
          this.displayFill = 0;
        }
        this.renderControlsAndGuide();
        this.rebuild3D();
      },

      clearGroup() {
        if (!this.group) return;
        this.group.traverse(object => {
          if (object.geometry) object.geometry.dispose();
          if (object.material) {
            const materials = Array.isArray(object.material) ? object.material : [object.material];
            materials.forEach(material => material.dispose());
          }
        });
        while (this.group.children.length) this.group.remove(this.group.children[0]);
        this.liquid = null;
      },

      addMesh(geometry, material, x = 0, y = 0) {
        const mesh = new THREE.Mesh(geometry, material);
        mesh.position.set(x, y, 0);
        this.group.add(mesh);
        return mesh;
      },

      addVessel(radius, height, x) {
        this.addMesh(new THREE.CylinderGeometry(radius, radius, height, 48, 1, true),
          new THREE.MeshPhongMaterial({ color: 0xb3d7ec, transparent: true, opacity: 0.25, side: THREE.DoubleSide, depthWrite: false }), x);
        [-height / 2, height / 2].forEach(y => {
          const rim = this.addMesh(new THREE.RingGeometry(radius * 0.985, radius * 1.02, 48),
            new THREE.MeshBasicMaterial({ color: 0x94cdeb, side: THREE.DoubleSide }), x, y);
          rim.rotation.x = Math.PI / 2;
        });
        const bottom = this.addMesh(new THREE.CircleGeometry(radius, 48),
          new THREE.MeshPhongMaterial({ color: 0x94a3b8, transparent: true, opacity: 0.28, side: THREE.DoubleSide }), x, -height / 2);
        bottom.rotation.x = Math.PI / 2;
      },

      addLiquid(radius, height, x) {
        this.liquidHeight = height;
        this.liquidX = x;
        this.liquid = this.addMesh(new THREE.CylinderGeometry(radius * 0.98, radius * 0.98, 1, 48),
          new THREE.MeshPhongMaterial({ color: 0x06b6d4, transparent: true, opacity: 0.86, shininess: 100 }), x);
        this.updateLiquidGeometry();
      },

      updateLiquidGeometry() {
        if (!this.liquid) return;
        this.liquid.visible = this.displayFill > 0.0001;
        const height = this.liquidHeight * this.displayFill;
        this.liquid.scale.y = Math.max(height, 0.0001);
        this.liquid.position.y = -this.liquidHeight / 2 + height / 2;
      },

      rebuild3D() {
        if (!this.group) return;
        this.clearGroup();
        const readout = document.getElementById('volumeLiveReadout');
        const fmt = value => Number(value.toFixed(3)).toLocaleString('es-PE', { maximumFractionDigits: 3 });
        if (this.currentExp === 1) {
          const rVis = this.r * 0.45, hVis = this.h * 0.45;
          const full = this.r * this.r * this.h;
          const liquid = full * this.fillLevel;
          readout.innerHTML = `
            <div class="font-futuristic font-bold text-teal-300">¿CUÁNTO CABE EN EL CILINDRO?</div>
            <div>Radio: <b>${fmt(this.r)} cm</b> · Altura: <b>${fmt(this.h)} cm</b></div>
            <div>Área de la base ≈ 3 × ${fmt(this.r)} × ${fmt(this.r)} = <b>${fmt(this.r*this.r*3)} cm²</b></div>
            <div>Capacidad total: <b>≈ ${fmt(full*3)} cm³</b></div>
            <div class="text-amber-300 font-black">Líquido: ≈ ${fmt(liquid*3)} cm³ (${Math.round(this.fillLevel*100)}%)</div>
            <div class="text-[10px]">Usamos π ≈ 3 para practicar.</div>`;
          this.addVessel(rVis, hVis, 0);
          this.addLiquid(rVis, hVis, 0);
        } else if (this.currentExp === 2) {
          const rVis = 0.8, hVis = 2.4;
          readout.innerHTML = `
            <div class="font-futuristic font-bold text-purple-300">TRES CONOS LLENAN EL CILINDRO</div>
            <div>Ambos: radio = 1 cm · altura = 3 cm</div>
            <div>Cilindro ≈ 3 × 1 × 1 × 3 = <b>9 cm³</b></div>
            <div>Cono ≈ 9 ÷ 3 = <b>3 cm³</b></div>
            <div>Vaciados: <b class="text-amber-300">${this.conePours} de 3</b> · Líquido: <b>≈ ${this.conePours*3} cm³</b></div>
            <div class="text-[10px]">Usamos π ≈ 3 para practicar.</div>`;
          this.addMesh(new THREE.ConeGeometry(rVis, hVis, 48, 1, true),
            new THREE.MeshPhongMaterial({ color: 0xa855f7, transparent: true, opacity: 0.42, side: THREE.DoubleSide, depthWrite: false }), -2.1);
          const base = this.addMesh(new THREE.CircleGeometry(rVis, 48),
            new THREE.MeshPhongMaterial({ color: 0xc084fc, transparent: true, opacity: 0.32, side: THREE.DoubleSide }), -2.1, -hVis / 2);
          base.rotation.x = Math.PI / 2;
          this.addVessel(rVis, hVis, 2.1);
          [-hVis / 6, hVis / 6].forEach(y => {
            const ring = this.addMesh(new THREE.RingGeometry(rVis * 0.99, rVis * 1.025, 48),
              new THREE.MeshBasicMaterial({ color: 0xfbbf24, side: THREE.DoubleSide }), 2.1, y);
            ring.rotation.x = Math.PI / 2;
          });
          this.addLiquid(rVis, hVis, 2.1);
        } else {
          const rVis = 1.5, z = this.cavalieriZ * rVis;
          const sectionRadius = Math.sqrt(Math.max(0, rVis * rVis - z * z));
          const realZ = this.cavalieriZ * 2;
          const areaCoefficient = Math.max(0, 4 - realZ * realZ);
          readout.innerHTML = `
            <div class="font-futuristic font-bold text-amber-300">MIRA LOS DOS CORTES AZULES</div>
            <div>Esfera a la izquierda · Recipiente a la derecha</div>
            <div>Radio de la esfera: <b>2 cm</b></div>
            <div>Los dos cortes tienen igual área: <b>≈ ${fmt(areaCoefficient*3)} cm²</b></div>
            <div class="text-emerald-300 font-black">Volumen de la esfera: ≈ 32 cm³</div>
            <div class="text-[10px]">Usamos π ≈ 3 para practicar.</div>`;
          this.addMesh(new THREE.SphereGeometry(rVis, 48, 32),
            new THREE.MeshPhongMaterial({ color: 0xf59e0b, transparent: true, opacity: 0.28, depthWrite: false }), -2.2);
          this.addVessel(rVis, 2 * rVis, 2.2);
          const top = this.addMesh(new THREE.ConeGeometry(rVis, rVis, 40, 8, true),
            new THREE.MeshBasicMaterial({ color: 0xf43f5e, wireframe: true, transparent: true, opacity: 0.32 }), 2.2, rVis / 2);
          top.rotation.x = Math.PI;
          this.addMesh(new THREE.ConeGeometry(rVis, rVis, 40, 8, true),
            new THREE.MeshBasicMaterial({ color: 0xf43f5e, wireframe: true, transparent: true, opacity: 0.32 }), 2.2, -rVis / 2);
