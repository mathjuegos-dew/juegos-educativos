    document.getElementById('qInteractionZone').innerHTML=`<div class="g4-result"><div class="g4-result-stars">${passed?'⭐'.repeat(stars):'🌱'}</div><p class="g4-result-count">${this.correct} de ${total} actividades resueltas</p><p>${passed?'Tu diploma está listo. Puedes volver a practicar cuando quieras.':'Con 6 actividades correctas consigues tu diploma. Ya sabes un poco más: vuelve a intentarlo con las pistas.'}</p><button onclick="GameEngine.startLevel(${this.level})" class="g4-check">VOLVER A PRACTICAR</button>${passed?`<button onclick="DiplomaSystem.openModal('level_${this.level}')" class="g4-result-diploma">VER MI DIPLOMA</button>`:''}<button onclick="GameEngine.quitToLevelMap()" class="g4-clear">ELEGIR OTRO NIVEL</button></div>`;
    document.getElementById('gameFormulaHelperText').textContent='Cada intento te ayuda a aprender. ¡Sigue explorando!';this.renderLevelMap();
  },
  quitToLevelMap(){this.active=false;this.paused=false;this.epoch++;document.querySelectorAll('.g4-drag-ghost').forEach(el=>el.remove());const play=document.getElementById('gameActivePlayView');play.classList.add('hidden');play.classList.remove('flex');document.getElementById('gameLevelSelectorView').classList.remove('hidden');this.renderLevelMap();SoundSystem.startMusicLoop('ambient');},
  resetDiagram(){GameDiagram.resetView();},zoomDiagram(factor){GameDiagram.zoom(factor);},
  toggleDiagramRotation(){const on=GameDiagram.toggleAutoRotate();const b=document.getElementById('g4Rotate');if(b){b.textContent=on?'⏸ Detener giro':'▶ Girar';b.setAttribute('aria-pressed',String(on));}},
  pause(){this.paused=true;},resume(){this.paused=false;},resize(){GameDiagram.resize();},
  update(dt){if(this.active||document.getElementById('gameLevelSelectorView').classList.contains('hidden'))GameDiagram.update(dt);}
};

const ConfettiSystem = {
  particles: [], frame: 0,
  burst() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const canvas = document.getElementById('confettiCanvas');
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    cancelAnimationFrame(this.frame);
    canvas.width = innerWidth; canvas.height = innerHeight;
    canvas.classList.remove('hidden');
    this.particles = Array.from({length:90},()=>({x:Math.random()*canvas.width,y:-20-Math.random()*150,
      vx:(Math.random()-.5)*4,vy:2+Math.random()*4,a:Math.random()*6,c:['#22d3ee','#fbbf24','#c084fc','#34d399'][Math.floor(Math.random()*4)]}));
    let start = performance.now();
    const draw = now => {
      ctx.clearRect(0,0,canvas.width,canvas.height);
      for (const p of this.particles) {p.x+=p.vx;p.y+=p.vy;p.a+=.08;ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.a);ctx.fillStyle=p.c;ctx.fillRect(-4,-4,8,8);ctx.restore();}
      if (now-start<3000) this.frame=requestAnimationFrame(draw);
      else {canvas.classList.add('hidden');ctx.clearRect(0,0,canvas.width,canvas.height);}
    };
    this.frame=requestAnimationFrame(draw);
  },
  celebrate() {this.burst();}
};

const DiplomaSystem = {
  selected: 'expert',
  earned(type) {
    if (type === 'expert') return Array.from({length:9},(_,i)=>i+1).every(id=>App.state.levels[id]?.completed);
    const id = Number(String(type).replace('level_',''));
    return id >= 1 && id <= 9 && App.state.levels[id]?.completed === true;
  },
  openModal(type='expert') {
    type = typeof type === 'number' ? 'level_'+type : String(type);
    if (/^\d$/.test(type)) type='level_'+type;
    if (!this.earned(type)) {App.toast(type==='expert' ? 'Completa los 9 niveles para obtener el diploma de experto.' : 'Supera este nivel con al menos 6 de 9 respuestas correctas para obtener su diploma.');return;}
    this.selected=type;
    const bar=document.getElementById('diplomaSelectorButtons');
    bar.replaceChildren();
    const types=Array.from({length:9},(_,i)=>'level_'+(i+1)).filter(t=>this.earned(t));
    if (this.earned('expert')) types.push('expert');
    types.forEach(t=>{const b=document.createElement('button');b.className='px-3 py-2 rounded-xl bg-cyan-600 text-white text-xs font-bold';b.textContent=t==='expert'?'Experto':'Nivel '+t.replace('level_','');b.onclick=()=>{this.selected=t;this.draw();};bar.appendChild(b);});
    App.openModal('modalDiploma');this.draw();
    document.fonts?.ready.then(()=>{if (!document.getElementById('modalDiploma').classList.contains('hidden')) this.draw();});
  },
  draw() {
    if (!this.earned(this.selected)) return;
    const canvas=document.getElementById('diplomaCanvas'),ctx=canvas.getContext('2d');
    const w=canvas.width,h=canvas.height;
    ctx.fillStyle='#fffdf5';ctx.fillRect(0,0,w,h);
    ctx.strokeStyle='#0891b2';ctx.lineWidth=10;ctx.strokeRect(24,24,w-48,h-48);
    ctx.strokeStyle='#d4a632';ctx.lineWidth=3;ctx.strokeRect(42,42,w-84,h-84);
    ctx.textAlign='center';ctx.fillStyle='#155e75';
    ctx.font='800 23px Orbitron, sans-serif';ctx.fillText('GEOMETRÍA 3D · 4.º DE PRIMARIA',w/2,105);
    ctx.font='900 60px Nunito, sans-serif';ctx.fillStyle='#0f172a';ctx.fillText('DIPLOMA DE RECONOCIMIENTO',w/2,196);
    ctx.font='700 25px Nunito, sans-serif';ctx.fillStyle='#475569';ctx.fillText('Se otorga a',w/2,262);
    let size=60;const name=App.state.studentName;
    do {ctx.font=`800 ${size}px Nunito, sans-serif`;if(ctx.measureText(name).width<w-170)break;size-=2;}while(size>20);
    ctx.fillStyle='#0369a1';ctx.fillText(name,w/2,346);
    ctx.strokeStyle='#cbd5e1';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(135,372);ctx.lineTo(w-135,372);ctx.stroke();
    const expert=this.selected==='expert';
    const id=Number(this.selected.replace('level_',''));
    ctx.font='800 32px Nunito, sans-serif';ctx.fillStyle='#92400e';
    ctx.fillText(expert?'EXPERTO EN GEOMETRÍA 3D':`NIVEL ${id} SUPERADO`,w/2,439);
    ctx.font='700 24px Nunito, sans-serif';ctx.fillStyle='#334155';
    ctx.fillText(expert?'Por completar los nueve niveles de geometría para 4.º de primaria.':'Por sus logros en el estudio de los cuerpos redondos.',w/2,486);
    const record=expert?Object.values(App.state.levels).filter(x=>x.date&&!Number.isNaN(Date.parse(x.date))).sort((a,b)=>Date.parse(b.date)-Date.parse(a.date))[0]:App.state.levels[id];
    const date=new Date(record?.date || Date.now());
    ctx.font='700 21px Nunito, sans-serif';ctx.fillText('Fecha: '+(Number.isNaN(date.getTime())?new Date():date).toLocaleDateString('es-PE',{year:'numeric',month:'long',day:'numeric'}),w/2,548);
    ctx.fillStyle='#155e75';ctx.font='42px "Great Vibes", cursive';ctx.fillText('Prof. Jhon Dewis',w/2,634);
    ctx.font='700 17px Nunito, sans-serif';ctx.fillStyle='#64748b';ctx.fillText('Diseñado por Prof. Jhon Dewis',w/2,680);
  },
  downloadPNG() {
    if(!this.earned(this.selected))return;
    this.draw();const a=document.createElement('a');a.download=`diploma-geometria-3d-${this.selected}.png`;
    a.href=document.getElementById('diplomaCanvas').toDataURL('image/png');document.body.appendChild(a);a.click();a.remove();
  },
  printDiploma() {
    if(!this.earned(this.selected))return;
    this.draw();
    document.getElementById('diplomaPrintFrame')?.remove();
    const frame=document.createElement('iframe');frame.id='diplomaPrintFrame';frame.style.cssText='position:fixed;width:0;height:0;border:0';document.body.appendChild(frame);
    const doc=frame.contentDocument;
    doc.open();doc.write('<!doctype html><html lang="es"><head><title>Diploma de geometría 3D</title><style>@page{size:A4 landscape;margin:10mm}body{margin:0;display:flex;justify-content:center}img{width:100%;height:auto;max-height:185mm;object-fit:contain}</style></head><body><img alt="Diploma personalizado"></body></html>');doc.close();
    const img=doc.querySelector('img');img.onload=()=>{frame.contentWindow.focus();frame.contentWindow.print();window.focus();document.getElementById('modalDiploma').querySelector('button')?.focus();};img.src=document.getElementById('diplomaCanvas').toDataURL('image/png');
  }
};

const App = {
  state:null,currentScreen:'home',modules:{},modalFocus:new Map(),
  init() {
    this.state=StorageService.load();
    document.getElementById('inputStudentName').value=this.state.studentName;
    this.applyTheme();this.updateStudentUI();
    SoundSystem.musicEnabled=this.state.musicEnabled;SoundSystem.sfxEnabled=this.state.sfxEnabled;SoundSystem.updateUI();
    this.setupDialogs();
    document.getElementById('inputStudentName').addEventListener('keydown',e=>{if(e.key==='Enter')this.enterLab('explore');});
    this.initModule('home');
    window.addEventListener('resize',()=>this.resize());
    document.addEventListener('visibilitychange',()=>{
      if(document.hidden){SoundSystem.stopMusicLoop();if(this.currentScreen==='game')GameEngine.pause?.();}
      else{if(this.currentScreen==='game'&&!this.activeModal())GameEngine.resume?.();if(SoundSystem.ctx?.state==='running')SoundSystem.startMusicLoop(GameEngine.mode==='challenge'&&this.currentScreen==='game'?'challenge':'ambient');this.resize();}
    });
    let previous=performance.now();
    const tick=now=>{const dt=Math.min(.1,(now-previous)/1000);previous=now;const module=this.modules[this.currentScreen];
      if(!document.hidden && module?.update)module.update(dt);
      this.frame=requestAnimationFrame(tick);
    };this.frame=requestAnimationFrame(tick);
    requestAnimationFrame(()=>this.resize());
  },
  onNameInput() {document.getElementById('nameWarningMsg').classList.add('hidden');},
  enterLab(screen='explore') {
    const input=document.getElementById('inputStudentName');
    const name=input.value.trim().replace(/\s+/g,' ');
    if(name.length<3 || !name.includes(' ')) {document.getElementById('nameWarningMsg').classList.remove('hidden');input.focus();return false;}
    const changing=StorageService.profileKey(name)!==StorageService.profileKey(this.state.studentName);
    if(changing&&this.modules.game)GameEngine.quitToLevelMap();
    this.state=StorageService.activateStudent(name,this.state);StorageService.save(this.state);input.value=name;this.updateStudentUI();
    if(changing){if(this.modules.area)AreaDiscoveryLab.selectExp(1);if(this.modules.game)GameEngine.renderLevelMap();}
    SoundSystem.init();SoundSystem.startMusicLoop('ambient');this.navigate(screen);return true;
  },
  updateStudentUI() {
    const named=Boolean(this.state.studentName);
    document.getElementById('headerStudentName').textContent=this.state.studentName||'Explorador';
    for(const id of ['topModuleNav','mobileModuleNav','headerStudentBadge']){
      const el=document.getElementById(id);el.toggleAttribute('data-locked',!named);
      if(id==='mobileModuleNav'&&named)el.classList.remove('hidden');
    }
  },
  initModule(name) {
    if(this.modules[name])return this.modules[name];
    const map={home:HomeShowcase3D,explore:ExploreLab,area:AreaDiscoveryLab,volume:VolumeLab,game:GameEngine};
    const ids={home:'homeCanvasContainer',explore:'exploreCanvasContainer',area:'areaCanvasContainer',volume:'volumeCanvasContainer',game:'gameQuestionCanvasContainer'};
    const module=map[name];
    try {module.init();this.modules[name]=module;}
    catch(error){console.error('Error al iniciar '+name,error);const el=document.getElementById(ids[name]);
      const msg=document.createElement('p');msg.className='p-5 text-white text-sm';msg.textContent='No se pudo iniciar la vista 3D. Activa la aceleración gráfica del navegador y vuelve a abrir el archivo.';el?.appendChild(msg);
      if(name==='game'){try{module.renderLevelMap();this.modules[name]=module;}catch(_){}}
    }
    return module;
  },
  navigate(name) {
    if(!['home','explore','area','volume','game'].includes(name))return;
    if(name!=='home'&&!this.state.studentName){document.getElementById('inputStudentName').focus();return;}
    if(this.currentScreen==='game'&&name!=='game')GameEngine.pause?.();
    this.currentScreen=name;
    for(const item of ['home','explore','area','volume','game'])document.getElementById('screen'+item[0].toUpperCase()+item.slice(1)).classList.toggle('hidden',item!==name);
    this.initModule(name);
    if(name==='game'&&!this.activeModal())GameEngine.resume?.();
    document.querySelectorAll('#topModuleNav button').forEach(b=>b.setAttribute('aria-current',b.id==='navBtn_'+name?'page':'false'));
    if(SoundSystem.ctx?.state==='running')SoundSystem.startMusicLoop(name==='game'&&GameEngine.mode==='challenge'?'challenge':'ambient');
    requestAnimationFrame(()=>{this.resize();window.scrollTo({top:0,behavior:'instant'});});
  },
  resize() {const module=this.modules[this.currentScreen];module?.resize?.();},
  applyTheme() {
    document.body.classList.toggle('day-mode',this.state.isDayMode);
    document.getElementById('iconDayNight').className=this.state.isDayMode?'fa-solid fa-sun text-amber-300':'fa-solid fa-moon text-amber-300';
    document.getElementById('txtDayNight').textContent=this.state.isDayMode?'Día':'Noche';
  },
  toggleDayNight(){this.state.isDayMode=!this.state.isDayMode;this.applyTheme();StorageService.save(this.state);},
  openModal(id) {
    const el=document.getElementById(id);this.modalFocus.set(id,document.activeElement);el.classList.remove('hidden');
    el.style.zIndex=id==='modalDiploma'?'61':'60';
    el.querySelector('button,input,[tabindex="0"]')?.focus();
    if(this.currentScreen==='game')GameEngine.pause?.();
  },
  closeModal(id){document.getElementById(id).classList.add('hidden');this.modalFocus.get(id)?.focus();
    if(this.currentScreen==='game'&&!this.activeModal())GameEngine.resume?.();},
  activeModal(){return ['modalDiploma','modalAchievements','modalGithubGuide'].map(id=>document.getElementById(id)).find(el=>!el.classList.contains('hidden'));},
  setupDialogs(){
    for(const id of ['modalAchievements','modalDiploma','modalGithubGuide']){
      const el=document.getElementById(id);el.setAttribute('role','dialog');el.setAttribute('aria-modal','true');el.setAttribute('aria-label',el.querySelector('h3')?.textContent.trim()||'Diálogo');
      el.addEventListener('click',e=>{if(e.target===el)this.closeModal(id);});
    }
    document.addEventListener('keydown',e=>{
      const modal=this.activeModal();if(!modal)return;
      if(e.key==='Escape'){e.preventDefault();this.closeModal(modal.id);return;}
      if(e.key==='Tab'){
        const items=[...modal.querySelectorAll('button:not(:disabled),a[href],input,[tabindex="0"]')].filter(x=>x.getClientRects().length);
        const first=items[0],last=items[items.length-1];
        if(e.shiftKey&&document.activeElement===first){e.preventDefault();last?.focus();}
        else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first?.focus();}
      }
    });
  },
  openGithubGuideModal(){this.openModal('modalGithubGuide');},
  openAchievementsModal(){
    const sub=document.getElementById('achievementsStudentSub');
    sub.textContent=(this.state.studentName||'Explorador')+' · '+(StorageService.persistent?'Progreso guardado en este navegador':'Progreso de esta sesión; el navegador no permite guardarlo');
    document.getElementById('resetConfirmBanner').classList.add('hidden');
    const body=document.getElementById('achievementsBody');body.replaceChildren();
    const count=Object.values(this.state.discoveredFormulas).filter(Boolean).length;
    const intro=document.createElement('p');intro.className='p-3 rounded-xl bg-cyan-500/15 font-bold';intro.textContent=`Fórmulas descubiertas: ${count} de 8. Niveles superados: ${Object.values(this.state.levels).filter(l=>l.completed).length} de 9.`;body.appendChild(intro);
    const grid=document.createElement('div');grid.className='grid grid-cols-1 sm:grid-cols-3 gap-3';body.appendChild(grid);
    for(let id=1;id<=9;id++){
      const record=this.state.levels[id];const card=document.createElement('div');card.className='p-3 rounded-xl bg-slate-900 text-slate-100 border border-cyan-500/30';
      const title=document.createElement('h4');title.className='font-extrabold text-amber-300';title.textContent=`Nivel ${id} · ${record?.completed?'Superado':'Pendiente'}`;card.appendChild(title);
      const score=document.createElement('p');score.className='text-xs my-2';score.textContent=record?`Mejor puntaje: ${record.bestScore} · ${record.accuracy}% de aciertos`: 'Aún no hay intentos registrados.';card.appendChild(score);
      if(record?.completed){const b=document.createElement('button');b.className='px-3 py-1.5 rounded-lg bg-cyan-600 text-white text-xs font-bold';b.textContent='Ver diploma';b.onclick=()=>DiplomaSystem.openModal('level_'+id);card.appendChild(b);}
      grid.appendChild(card);
    }
    this.openModal('modalAchievements');
  },
  confirmResetProgress(){
    this.state=StorageService.resetAll();
    GameEngine.quitToLevelMap?.();
    if(this.modules.area){AreaDiscoveryLab.expStep=1;AreaDiscoveryLab.renderGuidedPanel?.();}
    this.openAchievementsModal();
    this.toast('Se reinició el progreso de '+this.state.studentName+'.');
  },
  toast(message){let el=document.getElementById('appToast');if(!el){el=document.createElement('div');el.id='appToast';el.setAttribute('role','status');el.className='fixed bottom-5 left-1/2 z-[80] -translate-x-1/2 px-5 py-3 rounded-xl bg-slate-800 text-white shadow-xl text-sm font-bold max-w-[90vw]';document.body.appendChild(el);}el.textContent=message;el.classList.remove('hidden');clearTimeout(this.toastTimer);this.toastTimer=setTimeout(()=>el.classList.add('hidden'),4200);}
};

App.init();

</script>
