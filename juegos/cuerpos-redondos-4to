  <style>
    :root {
      --bg-lab: #060b19;
      --bg-panel: rgba(15, 23, 42, 0.86);
      --border-panel: rgba(56, 189, 248, 0.32);
      --text-primary: #f8fafc;
      --text-secondary: #94a3b8;
      --accent-cyan: #22d3ee;
      --accent-violet: #a855f7;
      --accent-gold: #fbbf24;
    }

    body.day-mode {
      --bg-lab: #ecfeff;
      --bg-panel: rgba(255, 255, 255, 0.92);
      --border-panel: rgba(14, 165, 233, 0.4);
      --text-primary: #0f172a;
      --text-secondary: #334155;
    }

    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      margin: 0;
      padding: 0;
      font-family: 'Nunito', sans-serif;
      background-color: var(--bg-lab);
      color: var(--text-primary);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      transition: background-color 0.4s ease, color 0.4s ease;
    }

    .font-futuristic {
      font-family: 'Orbitron', sans-serif;
    }

    /* Título animado estilo Laboratorio Científico Futurista */
    .lab-title {
      font-family: 'Orbitron', sans-serif;
      font-weight: 900;
      letter-spacing: 2px;
      background: linear-gradient(90deg, #38bdf8 0%, #2dd4bf 28%, #a855f7 58%, #fbbf24 85%, #38bdf8 100%);
      background-size: 250% auto;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: shineTitle 6s linear infinite, floatTitle 3.5s ease-in-out infinite;
      filter: drop-shadow(0 0 18px rgba(56, 189, 248, 0.45));
    }

    @keyframes shineTitle {
      0% { background-position: 0% center; }
      100% { background-position: 250% center; }
    }
    @keyframes floatTitle {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-4px); }
    }

    /* Paneles de cristal de laboratorio */
    .lab-panel {
      background: var(--bg-panel);
      backdrop-filter: blur(14px);
      border: 1.5px solid var(--border-panel);
      box-shadow: 0 10px 35px -8px rgba(6, 182, 212, 0.22);
      transition: background-color 0.35s ease, border-color 0.35s ease;
    }

    body.day-mode .lab-panel {
