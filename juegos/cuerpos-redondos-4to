      toggleMeasures() {
        this.showMeasures = !this.showMeasures;
        document.getElementById('exploreMeasuresOverlay').classList.toggle('hidden', !this.showMeasures);
        document.getElementById('btnToggleMeasures').innerHTML = `<i class="fa-solid fa-ruler-combined mr-1"></i> Medidas: ${this.showMeasures ? 'ON' : 'OFF'}`;
        this.rebuildModel();
      },

      toggleCutaway() {
        if (this.isUnfolded && this.currentSolid !== 'sphere') this.isUnfolded = false;
        this.isCutaway = !this.isCutaway;
        document.getElementById('btnToggleCut').className = this.isCutaway
          ? 'px-3 py-1.5 rounded-xl bg-amber-400 text-slate-950 text-xs font-extrabold shadow'
          : 'px-3 py-1.5 rounded-xl bg-purple-600/90 text-white text-xs font-extrabold shadow';
        this.rebuildModel();
      },

      toggleUnfold() {
        this.isUnfolded = !this.isUnfolded;
        this.isCutaway = false;
        document.getElementById('btnToggleCut').className='px-3 py-1.5 rounded-xl bg-purple-600/90 text-white text-xs font-extrabold shadow';
        SoundSystem.playSuccess();
        this.rebuildModel();
      },

      zoom(delta) {
        if (!this.camera) return;
        zoomThreeCamera(this.camera, Math.exp(delta * 0.09));
      },

      resetCamera() {
        if (!this.camera || !this.rootGroup) return;
        this.camera.position.set(0, 2.2, 11.5);
        this.rootGroup.rotation.set(0.25, -0.45, 0);
        fitThreeView(this,this.rootGroup,1.55);
      },

      rebuildModel() {
        if (!this.rootGroup) return;
        clearThreeGroup(this.rootGroup);
        const r = this.r * 0.55, h = this.h * 0.55, sel = this.selectedPart;
        this.rootGroup.scale.setScalar(this.scaleVal);
        const g = this.currentSolid === 'cylinder' ? this.h : Math.hypot(this.r, this.h);
        document.getElementById('lblMeasureR').innerHTML = 'Radio (r): <b class="text-cyan-300">' + this.r.toFixed(1) + ' cm</b>';
        document.getElementById('lblMeasureD').innerHTML = 'Diámetro (d): <b class="text-pink-300">' + (2*this.r).toFixed(1) + ' cm</b>';
        document.getElementById('lblMeasureH').innerHTML = this.currentSolid === 'sphere' ? 'Altura total (2r): <b>' + (2*this.r).toFixed(1) + ' cm</b>' : 'Altura (h): <b>' + this.h.toFixed(1) + ' cm</b>';
        document.getElementById('lblMeasureG').innerHTML = this.currentSolid === 'sphere' ? 'Giro generador: <b>360°</b>' : 'Generatriz (g): <b>' + g.toFixed(2) + ' cm</b>';
        const surface = (geo, color, key) => addThreeSurface(this.rootGroup, geo, sel === key ? 0xfbbf24 : color, key, sel === key ? 0.85 : 0.42);
        const line = (a,b,key,color) => { if (this.showMeasures) this.addLineElement(a,b, sel === key ? 0xfbbf24 : color, sel === key ? 0.075 : 0.035, key); };
        const theta = this.isCutaway ? Math.PI * 1.5 : 2 * Math.PI;
        if (this.currentSolid === 'cylinder') {
          if (this.isUnfolded) {
            surface(cylinderUnfoldGeometry(r,h,1),0x06b6d4,'lateral');
            [-1,1].forEach(sign => { const b=surface(new THREE.CircleGeometry(r,48),0x3b82f6,'bases'); b.position.set(0,sign*(h/2+r),0); });
          } else {
            surface(new THREE.CylinderGeometry(r,r,h,48,1,true,0,theta),0x06b6d4,'lateral');
            [-1,1].forEach(sign => { const b=surface(new THREE.CircleGeometry(r,48,-Math.PI/2,theta),0x3b82f6,'bases'); b.rotation.x=-Math.PI/2; b.position.y=sign*h/2; });
            line([0,-h/2,0],[r,-h/2,0],'radius',0x22d3ee);
            line([-r,h/2,0],[r,h/2,0],'diameter',0xf472b6);
            line([0,-h/2,0],[0,h/2,0],'height',0xa855f7);
            line([r,-h/2,0],[r,h/2,0],'generatrix',0x34d399);
          }
        } else if (this.currentSolid === 'cone') {
          if (this.isUnfolded) {
            surface(coneUnfoldGeometry(r,h,1),0x9333ea,'lateral');
            const base = surface(new THREE.CircleGeometry(r,48),0x3b82f6,'base');
            base.position.set(0,-Math.hypot(r,h)/2-r,0);
          } else {
            surface(new THREE.ConeGeometry(r,h,48,1,true,0,theta),0x9333ea,'lateral');
            const base=surface(new THREE.CircleGeometry(r,48,-Math.PI/2,theta),0x3b82f6,'base'); base.rotation.x=-Math.PI/2; base.position.y=-h/2;
            const vertex = new THREE.Mesh(new THREE.SphereGeometry(sel==='vertex'?0.18:0.11,12,12),new THREE.MeshBasicMaterial({color:sel==='vertex'?0xfbbf24:0xf43f5e}));
            vertex.position.y=h/2; vertex.userData.partKey='vertex'; this.rootGroup.add(vertex);
            if (this.showMeasures || sel==='generatrix') {
              const triangle = new THREE.BufferGeometry(); triangle.setAttribute('position',new THREE.Float32BufferAttribute([0,-h/2,0,r,-h/2,0,0,h/2,0],3));
              addThreeSurface(this.rootGroup,triangle,0xfbbf24,'generatrix',0.2);
            }
            line([0,-h/2,0],[r,-h/2,0],'radius',0x22d3ee);
            line([-r,-h/2,0],[r,-h/2,0],'diameter',0xf472b6);
            line([0,-h/2,0],[0,h/2,0],'height',0xa855f7);
            line([0,h/2,0],[r,-h/2,0],'generatrix',0x10b981);
          }
        } else {
          const sphere=surface(new THREE.SphereGeometry(r,48,24,0,theta),0x0ea5e9,'surface');
          if (this.isUnfolded) sphere.material.opacity=0.2;
          const center = new THREE.Mesh(new THREE.SphereGeometry(sel==='center'?0.17:0.1,12,12),new THREE.MeshBasicMaterial({color:sel==='center'?0xfbbf24:0xef4444}));
          center.userData.partKey='center'; this.rootGroup.add(center);
          line([0,0,0],[r,0,0],'radius',0x22d3ee); line([0,-r,0],[0,r,0],'diameter',0xf472b6);
          const pts=[]; for(let i=0;i<=48;i++){const a=-Math.PI/2+i*Math.PI/48;pts.push(new THREE.Vector3(r*Math.cos(a),r*Math.sin(a),0));}
          const semi = new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts),new THREE.LineBasicMaterial({color:0xfde047})); semi.name='revolvingSemicircle'; semi.userData.partKey='surface'; this.rootGroup.add(semi);
        }
        document.getElementById('btnToggleUnfold').innerHTML = this.currentSolid === 'sphere'
          ? '<i class="fa-solid fa-rotate mr-1"></i> ' + (this.isUnfolded ? 'Giro normal' : 'Generar esfera')
          : '<i class="fa-solid fa-box-open mr-1"></i> ' + (this.isUnfolded ? 'Replegar' : 'Desplegar');
        const key=[this.currentSolid,this.r,this.h,this.isUnfolded].join(':');
        if(this.lastFitKey!==key){this.lastFitKey=key;fitThreeView(this,this.rootGroup,1.55);}
      },

      addLineElement(p1, p2, hexColor, radiusTub, partKey) {
        const v1 = new THREE.Vector3(...p1);
        const v2 = new THREE.Vector3(...p2);
        const dir = new THREE.Vector3().subVectors(v2, v1);
        const len = dir.length();
        const cylGeo = new THREE.CylinderGeometry(radiusTub, radiusTub, len, 12);
        const cylMat = new THREE.MeshBasicMaterial({ color: hexColor });
        const mesh = new THREE.Mesh(cylGeo, cylMat);
        mesh.position.copy(v1).add(v2).multiplyScalar(0.5);
        mesh.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), dir.clone().normalize());
        mesh.userData = { partKey };
        this.rootGroup.add(mesh);
      },

      update(dt = 1/60) {
        this.frameDelta = Math.max(0,Math.min(0.1,Number(dt)||1/60));
        if (!this.renderer || document.getElementById('screenExplore').classList.contains('hidden')) return;
        const semi = this.rootGroup.getObjectByName('revolvingSemicircle');
        if (semi) {
          semi.rotation.y += (this.isUnfolded ? 2.5 : 0.7) * this.frameDelta;
        }
        this.renderer.render(this.scene, this.camera);
      },

      resize() { resizeThreeView(this,'exploreCanvasContainer',this.rootGroup); }
    };

    /********************************************************************
