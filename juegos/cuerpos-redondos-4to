        this.sphere.add(new THREE.LineSegments(new THREE.WireframeGeometry(new THREE.SphereGeometry(1.36, 12, 10)), new THREE.LineBasicMaterial({ color: 0xfef08a, transparent: true, opacity: 0.35 })));
        this.group.add(this.sphere);

        // Partículas científicas flotantes
        const pGeo = new THREE.BufferGeometry();
        const pCount = 90;
