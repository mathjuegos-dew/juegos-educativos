      font-family: 'Great Vibes', cursive;
      font-size: 1.65rem;
      font-weight: 400;
      letter-spacing: 0.8px;
      background: linear-gradient(
        90deg,
        #fbbf24 0%,
        #38bdf8 22%,
        #a855f7 45%,
        #2dd4bf 68%,
        #ec4899 86%,
        #fbbf24 100%
      );
      background-size: 300% 100%;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: signatureGradient 8s linear infinite;
      filter: drop-shadow(0 0 8px rgba(56, 189, 248, 0.32));
      display: inline-block;
      padding: 0 6px;
      line-height: 1.15;
      vertical-align: middle;
    }

    body.day-mode .dewis-signature {
      filter: drop-shadow(0 1px 4px rgba(15, 23, 42, 0.18));
    }

    @keyframes signatureGradient {
      0% { background-position: 0% 50%; }
      100% { background-position: 300% 50%; }
    }

    /* Fracciones y expresiones matemáticas elegantes */
    .math-pill {
      display: inline-flex;
