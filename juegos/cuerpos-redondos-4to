        document.getElementById('valSliderR').textContent = `${this.r.toFixed(1)} cm (Diámetro = ${(this.r * 2).toFixed(1)} cm)`;
        document.getElementById('valSliderH').textContent = `${this.h.toFixed(1)} cm`;
        document.getElementById('valSliderScale').textContent = `${Math.round(this.scaleVal * 100)}%`;

        this.rebuildModel();
