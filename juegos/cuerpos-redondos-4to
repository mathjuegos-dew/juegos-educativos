        this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        container.appendChild(this.renderer.domElement);

        this.scene.add(new THREE.AmbientLight(0xffffff, 0.8));
        const dLight = new THREE.DirectionalLight(0xffffff, 1.0);
        dLight.position.set(6, 10, 8);
        this.scene.add(dLight);

        this.rootGroup = new THREE.Group();
        this.rootGroup.rotation.x = 0.25;
        this.rootGroup.rotation.y = -0.45;
        this.scene.add(this.rootGroup);

        attachOrbitAndRaycast(this.renderer.domElement, this.camera, this.rootGroup, (partKey) => {
          this.selectPart(partKey);
        });

        this.selectSolid('cylinder');
      },

      selectSolid(solidType) {
        if (!SOLID_PARTS_INFO[solidType]) return;
        this.currentSolid = solidType;
        this.isUnfolded = false;
        this.unfoldProgress = 0;

        ['cylinder', 'cone', 'sphere'].forEach(s => {
          const btn = document.getElementById(`btnSolid_${s}`);
          if (!btn) return;
          if (s === solidType) {
            btn.className = 'lab-btn px-4 py-1.5 rounded-xl font-futuristic font-bold text-xs sm:text-sm bg-cyan-400 text-slate-950 shadow-lg';
          } else {
            btn.className = 'lab-btn px-4 py-1.5 rounded-xl font-futuristic font-bold text-xs sm:text-sm bg-slate-800 text-slate-200 border border-white/15';
          }
        });

        document.getElementById('boxSliderH').classList.toggle('hidden', solidType === 'sphere');
        const info = SOLID_PARTS_INFO[solidType];
        document.getElementById('exploreSolidTitle').textContent = info.title;

        const grid = document.getElementById('explorePartsGrid');
        grid.innerHTML = info.parts.map(p => `
          <button onclick="ExploreLab.selectPart('${p.key}')" id="btnPart_${p.key}" class="p-2 rounded-xl border border-white/15 bg-slate-900/75 hover:bg-cyan-500/20 text-left text-xs font-extrabold flex items-center gap-2 transition">
            <i class="fa-solid ${p.icon} text-cyan-400"></i>
            <span class="truncate">${p.label}</span>
          </button>
        `).join('');

        this.selectPart(info.parts[0].key);
      },

      selectPart(partKey) {
        if (!SOLID_PARTS_INFO[this.currentSolid].parts.some(p => p.key === partKey)) return;
        this.selectedPart = partKey;
        const info = SOLID_PARTS_INFO[this.currentSolid];
        const partObj = info.parts.find(p => p.key === partKey) || info.parts[0];

        info.parts.forEach(p => {
          const b = document.getElementById(`btnPart_${p.key}`);
          if (b) {
            b.className = p.key === partKey
              ? 'p-2 rounded-xl border-2 border-amber-400 bg-amber-500/25 text-amber-200 text-left text-xs font-extrabold flex items-center gap-2 shadow'
              : 'p-2 rounded-xl border border-white/15 bg-slate-900/75 hover:bg-cyan-500/20 text-left text-xs font-extrabold flex items-center gap-2 transition';
          }
        });

        document.getElementById('partInfoTitle').innerHTML = `<i class="fa-solid ${partObj.icon} text-amber-300"></i> ${partObj.label}`;
