        const t = Date.now() * 0.0012;
        if (this.cyl) {
          this.cyl.rotation.y = t;
          this.cyl.rotation.x = Math.sin(t * 0.7) * 0.25;
        }
        if (this.cone) {
          this.cone.rotation.y = -t * 1.1;
          this.cone.rotation.z = Math.cos(t * 0.8) * 0.2;
